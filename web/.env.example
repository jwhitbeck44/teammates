# Copy to .env.local for local development.
# Base path the app is served from. Use '/<repo-name>/' on GitHub Pages.
VITE_BASE_PATH=/
# Supabase project URL and publishable key (sb_publishable_...). Never put a secret key here.
# The older name VITE_SUPABASE_ANON_KEY is still read if VITE_SUPABASE_PUBLISHABLE_KEY is not set.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
