# Copy to .env.local for local development.
# Base path the app is served from. Use '/<repo-name>/' on GitHub Pages.
VITE_BASE_PATH=/
# Supabase project URL and anon (public) key. Never put the service-role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
